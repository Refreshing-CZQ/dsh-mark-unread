{
  "name": "dsh-mark-unread",
  "version": "1.2.0",
  "description": "Adds a Mark as unread hover button to every Session row in DeepSeek Harness, beside Pin and Archive, with a dot that clears itself once the Session is opened.",
  "type": "module",
  "license": "MIT",
  "author": "Refreshing-CZQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Refreshing-CZQ/dsh-mark-unread.git"
  },
  "homepage": "https://github.com/Refreshing-CZQ/dsh-mark-unread#readme",
  "bugs": {
    "url": "https://github.com/Refreshing-CZQ/dsh-mark-unread/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "sidebar",
    "unread"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
